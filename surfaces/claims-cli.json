{
  "permissions": {
    "allow": [
      "Bash(claims:*)"
    ],
    "deny": [
      "Bash(claims delete:*)",
      "Bash(claims change:*)",
      "Bash(claims encrypt:*)",
      "Bash(kubectl:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(vault:*)",
      "Bash(ssh:*)",
      "Read(~/.config/claims/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
