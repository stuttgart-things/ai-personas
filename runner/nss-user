# Sourced by persona-run (and the smoke test). ssh takes its home directory
# (~/.ssh/config, the key, the certificate) from the passwd entry, not from
# $HOME, and refuses to start without an entry ("No user exists for uid ...").
# persona-run writes the ssh files to $HOME, so the passwd home has to be
# $HOME. Two cases need a substitute entry:
#   - run.sh starts the container as the caller's uid (so /out stays writable
#     for them): the image has no entry for that uid;
#   - Tekton starts it as uid 10001 (the image's persona, home /home/persona)
#     with HOME=/tmp/persona-home: the entry exists, its home is a different one.
# nss_wrapper gives the process an entry with home $HOME without touching /etc.
_home=${HOME:-/tmp}
if [ "$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)" != "$_home" ]; then
  _nss=$_home/.nss
  mkdir -p "$_nss"
  { grep -v "^[^:]*:[^:]*:$(id -u):" /etc/passwd
    printf 'persona:x:%s:%s:persona:%s:/bin/bash\n' "$(id -u)" "$(id -g)" "$_home"; } > "$_nss/passwd"
  { cat /etc/group; getent group "$(id -g)" >/dev/null || printf 'persona:x:%s:\n' "$(id -g)"; } > "$_nss/group"
  export LD_PRELOAD=libnss_wrapper.so NSS_WRAPPER_PASSWD=$_nss/passwd NSS_WRAPPER_GROUP=$_nss/group
  unset _nss
fi
unset _home
