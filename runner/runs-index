#!/usr/bin/env bash
# Writes the indexes of the runs repository (ADR 0005): README.md at the top
# with every run, and runs/<scenario>/README.md with that scenario's runs,
# newest first. Generated from runs/<scenario>/<run>/summary.json.
# usage: runner/runs-index <repo dir>
set -euo pipefail
root=${1:?repo dir}

# rows <dir> <link prefix>: one table row per run under <dir>, newest first
rows() {
  find "$1" -mindepth 2 -maxdepth 3 -name summary.json 2>/dev/null |
    awk -F/ '{print $(NF-1) "\t" $0}' | sort -r | cut -f2 |
    while read -r s; do
      d=$(dirname "$s"); rel=${d#"$1"/}
      fr=0; [ -f "$d/friction.txt" ] && fr=$(grep -vc '^FRICTION: keine' "$d/friction.txt" || true)
      jq -r --arg rel "$2$rel" --arg fr "$fr" '
        "| [\(.run)](\($rel)/transcript.md) | \(.persona) | \(.scenario) | \(.lab // "") | \(.merge // "human") | " +
        "\(((.result.result // "") | capture("(?i)ziel erreicht:?\\**:?\\s*(?<g>ja|nein|teilweise)") | .g | ascii_downcase) // "?") | " +
        "\(.result.subtype // "–")\(if .result.is_error then " (error)" else "" end) | \(.result.num_turns // "") | " +
        "\(if .result.total_cost_usd then "\((.result.total_cost_usd * 100 | round) / 100) USD" else "" end) | \($fr) | " +
        "\(if (.cleanup.mode // "") != "delete-claim" then "–" elif (.cleanup.orders | type) != "array" then "?"
            elif all(.cleanup.orders[]; .outcome | IN("deleted", "cancelled", "nothing")) then "ok"
            else "open" end) |"' "$s"
    done
}
header='| Run | Persona | Scenario | Lab | Merge | Goal | Claude | Turns | Cost | Friction | Cleanup |
|---|---|---|---|---|---|---|---|---|---|---|'

{
  cat <<'HEAD'
# AI persona runs

Reports of the persona test runs ([stuttgart-things/ai-personas](https://github.com/stuttgart-things/ai-personas), ADR 0005), filed as `runs/<scenario>/<yyyy-mm-ddThh-mm>-<persona>/`; each scenario folder has its own index. Each run has `transcript.md` (readable: commands with start and duration, the order's timeline, output, friction), `transcript.jsonl` (raw), `summary.json`, `friction.txt` and, where the runner cleaned up, `cleanup.json`. Written by `runner/publish-run`; the indexes are generated, do not edit. *Goal* is the persona's own verdict ("Ziel erreicht: ja / teilweise / nein"); *Claude* is whether the claude run itself finished; *Cleanup* is whether the runner removed what the run ordered (ADR 0007 in ai-personas: ok, open = something is left, – = scenario keeps it).

## Scenarios

HEAD
  for sd in "$root"/runs/*/; do
    [ -d "$sd" ] || continue
    sc=$(basename "$sd"); n=$(find "$sd" -mindepth 2 -maxdepth 2 -name summary.json | wc -l)
    echo "- [$sc](runs/$sc/README.md): $n run(s)"
  done
  printf '\n## All runs\n\n%s\n' "$header"
  rows "$root/runs" "runs/"
} > "$root/README.md"

for sd in "$root"/runs/*/; do
  [ -d "$sd" ] || continue
  sc=$(basename "$sd")
  { printf '# %s\n\nRuns of scenario `%s`, newest first. Generated by `runner/runs-index`, do not edit.\n\n%s\n' "$sc" "$sc" "$header"
    rows "${sd%/}" ""
  } > "$sd/README.md"
done
