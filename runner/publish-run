#!/usr/bin/env bash
# Files one run's report in the private runs repository (ADR 0005) and
# rebuilds its index. Host side only, with the host's git credentials; the
# persona never sees them. Only runs that passed the leak check exist.
# usage: runner/publish-run <run dir> <owner/repo>
set -euo pipefail
dir=$(cd "${1:?run dir}" && pwd); repo=${2:?owner/repo}
id=$(basename "$dir")
[ -s "$dir/summary.json" ] || { echo "publish-run: $dir has no summary.json" >&2; exit 1; }
here=$(cd "$(dirname "$0")" && pwd)

# runs/<scenario>/<yyyy-mm-ddThh-mm>-<persona>: one folder per scenario, its
# runs sorted by time below it. The run id's trailing -<scenario> is dropped,
# because the folder already names it.
dest_of() {
  local scenario name
  scenario=$(jq -r '.scenario // "unknown"' "$1")
  name=${2%-"$scenario"}
  echo "runs/$scenario/$name"
}

for attempt in 1 2 3; do
  tmp=$(mktemp -d)
  git clone -q --depth 1 "https://github.com/$repo.git" "$tmp/r"
  dest=$(dest_of "$dir/summary.json" "$id")   # runs/<scenario>/<time>-<persona>
  mkdir -p "$tmp/r/$dest"
  for f in transcript.md transcript.jsonl summary.json friction.txt; do
    [ -f "$dir/$f" ] && cp "$dir/$f" "$tmp/r/$dest/"
  done
  "$here/runs-index" "$tmp/r"
  git -C "$tmp/r" add -A
  if git -C "$tmp/r" diff --cached --quiet; then
    echo "publish-run: $id unchanged in $repo"; rm -rf "$tmp"; exit 0
  fi
  res=$(jq -r '.result.subtype // "no result"' "$dir/summary.json")
  git -C "$tmp/r" commit -q -m "run: $id ($res)"
  if git -C "$tmp/r" push -q origin HEAD:main 2>/dev/null; then
    echo "publish-run: https://github.com/$repo/blob/main/$dest/transcript.md"
    rm -rf "$tmp"; exit 0
  fi
  rm -rf "$tmp"; sleep $((attempt * 3))   # someone else pushed: start over
done
echo "publish-run: pushing to $repo failed" >&2; exit 1
