# Runner image of the AI personas (docs/concept.md, section Ausführung).
# Only what a user has: claude, claims, curl, jq, a YAML parser, an ssh
# client. No kubectl, gh, git or vault -- the persona cannot reach anything its
# token does not allow. ssh works only with a short-lived certificate the
# runner mounts for scenarios that ask for it (ADR 0003). Build from the
# repository root:
#   docker build -f runner/Containerfile -t ai-personas-runner .
#   dagger -c 'host | directory . | docker-build --dockerfile runner/Containerfile'
FROM docker.io/library/node:22-trixie-slim

ARG CLAUDE_CODE_VERSION=2.1.326
ARG CLAIMS_VERSION=0.30.0
ARG JS_YAML_VERSION=4.3.2
ARG TARGETARCH=amd64

RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends ca-certificates curl jq openssh-client libnss-wrapper \
 && rm -rf /var/lib/apt/lists/*

# npm and corepack only install; the persona does not need them, and they
# bring most of the image's Node findings (#24). Claude Code must not update
# itself either: the version is pinned above.
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" "js-yaml@${JS_YAML_VERSION}" \
 && npm cache clean --force \
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /root/.npm
ENV DISABLE_AUTOUPDATER=1

# claims from its GitHub release, checked against the release's checksums.
RUN set -eux; \
    f="claims_${CLAIMS_VERSION}_linux_${TARGETARCH}.tar.gz"; \
    base="https://github.com/stuttgart-things/claims/releases/download/v${CLAIMS_VERSION}"; \
    cd /tmp; \
    curl -fsSLO "${base}/${f}"; \
    curl -fsSL "${base}/checksums.txt" | grep " ${f}\$" | sha256sum -c -; \
    tar -xzf "${f}" claims; \
    install -m 0755 claims /usr/local/bin/claims; \
    rm -f /tmp/claims /tmp/"${f}"

# Fail the build if a tool the persona must not have slipped in.
RUN for t in kubectl gh git vault npm npx corepack; do \
      if command -v "$t" >/dev/null; then echo "forbidden tool in image: $t"; exit 1; fi; \
    done

RUN useradd --create-home --uid 10001 persona
WORKDIR /opt/ai-personas
COPY personas/ personas/
COPY scenarios/ scenarios/
COPY surfaces/ surfaces/
COPY runner/entrypoint.sh /usr/local/bin/persona-run
COPY runner/report /usr/local/bin/persona-report
COPY runner/summary /usr/local/bin/persona-summary
COPY runner/cleanup /usr/local/bin/persona-cleanup
COPY runner/nss-user /usr/local/lib/persona-nss-user

USER persona
WORKDIR /home/persona
ENTRYPOINT ["/usr/local/bin/persona-run"]
